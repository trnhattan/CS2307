APP_NAME=Adaptive Exam API

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501
API_BASE_URL=http://localhost:8000
API_REQUEST_TIMEOUT_SECONDS=180

BACKEND_IMAGE=nhattant/cs2307:backend-v1.0.0
FRONTEND_IMAGE=nhattant/cs2307:frontend-v1.0.0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
CLOUDBEAVER_PORT=8978

AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_MINUTES=480

QUESTION_BUNDLE_SCHEMA_PATH=scripts/adaptive_exam_question_bundle.schema.json
MAX_UPLOAD_BYTES=10485760
MAX_LINE_BYTES=2097152
MAX_IMPORT_LINES=5000

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_APP_TITLE=CS2307 Adaptive Exam

# The administrator selects the provider and model in the Configuration page.
# Keep this key only in .env; never add it to sys_props or source control.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_THINKING_LEVEL=low

LLM_TIMEOUT_SECONDS=120
MCP_ISSUER_URL=http://localhost:8000
MCP_PUBLIC_URL=http://localhost:8000/mcp
